# Paycard API Key — get from https://mapaycard.com
# IMPORTANT: never prefix with NEXT_PUBLIC_ — server-only
PAYCARD_API_KEY=your_paycard_api_key_here

# LengoPay credentials — get from https://portal.lengopay.com
# IMPORTANT: Authorization header uses "Basic {key}" — NOT standard base64 Basic Auth
LENGOPAY_LICENSE_KEY=your_lengopay_license_key_here
# websiteid is a SEPARATE param from the license key — both are required
LENGOPAY_WEBSITE_ID=your_lengopay_website_id_here

# Djomy credentials — get from https://developers.djomy.africa/
# Auth: HMAC-SHA256(clientId, clientSecret) → POST /v1/auth → Bearer token
# Both CLIENT_ID and CLIENT_SECRET are required for every request
DJOMY_CLIENT_ID=your_djomy_client_id_here
DJOMY_CLIENT_SECRET=your_djomy_client_secret_here

# Base URL of your deployment (no trailing slash)
# IMPORTANT for Djomy: returnUrl/cancelUrl must be HTTPS — use your ngrok URL in dev
# e.g. NEXT_PUBLIC_BASE_URL=https://xxxx-xxxx.ngrok-free.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
