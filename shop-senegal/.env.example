# Supabase project — https://supabase.com/dashboard/project/_/settings/api
# Uses Supabase's new API key format (publishable/secret), not the legacy anon/service_role JWTs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never expose to the browser.
# Used only in app/api/orders/route.ts and app/checkout/confirmation/page.tsx (via lib/supabase/server.ts)
# to bypass Row Level Security for writing/reading payment records.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Base URL of your deployment (no trailing slash) — used to build Bictorys'
# successRedirectUrl/errorRedirectUrl. Must be HTTPS outside of localhost, or
# Bictorys rejects the charge request (E400-0). Use an ngrok HTTPS tunnel in dev.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Bictorys — public key used to create a charge (create_charge)
# Get it from https://dashboard.bictorys.com — Développeurs → API Keys & Webhooks
BICTORYS_API_KEY=your_bictorys_public_key_here

# Bictorys — private key used to verify a transaction (verify_transaction)
BICTORYS_PRIVATE_KEY=your_bictorys_private_key_here

# Bictorys — shared secret used to verify webhook signatures
BICTORYS_WEBHOOK_SECRET=your_bictorys_webhook_secret_here

# Optional — point at the Bictorys sandbox in dev (production is the default)
# BICTORYS_API_BASE_URL=https://api.test.bictorys.com
